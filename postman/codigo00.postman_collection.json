{
  "info": {
    "name": "Código 00 — Pruebas de contrato",
    "description": "Compuerta G4: valida contrato, códigos de respuesta y reglas de negocio de la API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "apiKeyA",
      "value": ""
    },
    {
      "key": "apiKeyB",
      "value": ""
    },
    {
      "key": "expYear",
      "value": "2030"
    },
    {
      "key": "txSchema",
      "value": "{\"type\": \"object\", \"required\": [\"transaction_id\", \"type\", \"response_code\", \"response_message\", \"approved\", \"status\", \"amount\", \"currency\", \"created_at\"], \"properties\": {\"transaction_id\": {\"type\": \"string\", \"pattern\": \"^[0-9a-f-]{36}$\"}, \"type\": {\"enum\": [\"AUTHORIZATION\", \"REVERSAL\"]}, \"response_code\": {\"type\": \"string\", \"pattern\": \"^[0-9]{2}$\"}, \"response_message\": {\"type\": \"string\"}, \"approved\": {\"type\": \"boolean\"}, \"status\": {\"enum\": [\"APPROVED\", \"DECLINED\", \"REVERSED\"]}, \"amount\": {\"type\": \"string\"}, \"currency\": {\"enum\": [\"COP\", \"USD\"]}, \"masked_pan\": {\"type\": [\"string\", \"null\"], \"pattern\": \"^[0-9]{6}\\\\*+[0-9]{4}$\"}, \"auth_code\": {\"type\": [\"string\", \"null\"]}, \"created_at\": {\"type\": \"string\"}}}"
    }
  ],
  "item": [
    {
      "name": "01 Salud del servicio",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('$randomStan', String(Math.floor(100000 + Math.random() * 900000)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Tiempo de respuesta < 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));",
              "pm.test('Cabeceras de seguridad presentes', () => {",
              "  ['X-Content-Type-Options','X-Frame-Options','Content-Security-Policy','Cache-Control']",
              "    .forEach(h => pm.response.to.have.header(h));",
              "});",
              "pm.test('No expone el PAN completo', () => pm.expect(pm.response.text()).to.not.include('4111111111111111'));",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Autorización aprobada (00)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKeyA}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/authorizations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "authorizations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"card_number\": \"4111111111111111\",\n  \"exp_month\": 12,\n  \"exp_year\": {{expYear}},\n  \"amount\": \"150000.00\",\n  \"currency\": \"COP\",\n  \"stan\": \"{{$randomStan}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('$randomStan', String(Math.floor(100000 + Math.random() * 900000)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Tiempo de respuesta < 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));",
              "pm.test('Cabeceras de seguridad presentes', () => {",
              "  ['X-Content-Type-Options','X-Frame-Options','Content-Security-Policy','Cache-Control']",
              "    .forEach(h => pm.response.to.have.header(h));",
              "});",
              "pm.test('No expone el PAN completo', () => pm.expect(pm.response.text()).to.not.include('4111111111111111'));",
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Código de respuesta 00', () => pm.expect(pm.response.json().response_code).to.eql('00'));",
              "pm.test('Cumple el contrato', () => pm.response.to.have.jsonSchema(pm.collectionVariables.get('txSchema') ? JSON.parse(pm.collectionVariables.get('txSchema')) : {}));",
              "const r = pm.response.json();",
              "pm.test('Código de autorización de 6 dígitos', () => pm.expect(r.auth_code).to.match(/^\\d{6}$/));",
              "pm.test('PAN enmascarado', () => pm.expect(r.masked_pan).to.eql('411111******1111'));",
              "pm.collectionVariables.set('txId', r.transaction_id);",
              "pm.collectionVariables.set('fixedStan', r.stan);"
            ]
          }
        }
      ]
    },
